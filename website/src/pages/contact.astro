---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Contact Clixite SRL about Evidentia: licensing, deployments, security reports and privacy requests." path="/contact" pageType="ContactPage" breadcrumbs={[{ name: 'Contact', path: '/contact' }]}>
  <section class="hero wrap"><span class="eyebrow">Contact</span><h1>Talk to the people who built it.</h1><p class="lede">No forms, no trackers — email works.</p></section>
  <section class="block"><div class="wrap">
    <div class="cards">
      <div class="card"><h3>Licensing and deployments</h3><p><a href="mailto:hello@clixite.eu">hello@clixite.eu</a></p><p class="kicker">Commercial terms, operated deployments, integration work.</p></div>
      <div class="card"><h3>Security</h3><p><a href="mailto:security@clixite.eu">security@clixite.eu</a></p><p class="kicker">Vulnerability reports — see the <a href="/security">security page</a> for the disclosure process.</p></div>
      <div class="card"><h3>Privacy</h3><p><a href="mailto:privacy@clixite.eu">privacy@clixite.eu</a></p><p class="kicker">Data-subject requests and questions about this site.</p></div>
      <div class="card"><h3>Source and issues</h3><p><a href="https://github.com/clixite/GEO-EU" rel="noopener">github.com/clixite/GEO-EU</a></p><p class="kicker">Repository access for customers and partners.</p></div>
    </div>
    <p class="byline">Clixite SRL — Belgium</p>
  </div></section>
</Base>
