---
import Base from '../../layouts/Base.astro';
const groups = [
  ['Store', [['init', 'Create the store, register the local embedding model, create the signing key'], ['status', 'Knowledge stats, models, approvals, drafts, 30-day cost, ledger check'], ['version', 'Versions']]],
  ['Readiness', [['analyze <url|file> [--robots f] [--brand n] [--out f]', 'readiness-v1 report; live URLs fetch the page, robots.txt and llms.txt through safeFetch']]],
  ['Knowledge', [['source add <locator> [--kind] [--authority] [--owner]', 'Register a source'], ['source list | source delete <id> --reason', ''], ['ingest <sourceId> --file f | --url u [--authority]', 'Ingest content (exit 5 when quarantined)'], ['search <query> [--k] [--decompose] [--include-quarantined]', 'Hybrid search with citations'], ['claims [--document id] · entities', 'Extracted claims and resolved entities'], ['quarantine list | release <id> --note | hold <id> --note', 'Reviewer decisions on suspected injection'], ['dsar find <term> · dsar redact <term> --replacement r --reason t', 'Data-subject lookup and audited redaction']]],
  ['Content', [['draft generate --title --slug --query [--brand] [--classes] [--outline] [--max-words]', 'Evidence-grounded draft via a policy-allowed model, verified on creation'], ['draft create --title --slug --file f [--evidence-query q] [--ai-assisted] [--topics]', 'Human-written draft with retrieved evidence'], ['draft verify <id>', 'Deterministic claim verification (exit 6 when unsupported)'], ['draft gate <id>', 'Apply the publication policy (exit 6 when blocked)'], ['draft approve|reject <id> [--note]', 'Second-person decision (four-eyes)'], ['draft publish <id> --target static:<dir>|wordpress:<url>|http:<url> --editor n --role r', 'Publish with disclosure and signed manifest'], ['draft list|show|preview', ''], ['approvals', 'Pending approvals']]],
  ['Observatory', [['observe save --file set.json', 'Save a versioned query set'], ['observe run <setId> --models p/m[,p/m] [--samples 8] [--store-raw]', 'Sample through official APIs'], ['observe report <setId> [--from] [--to] [--out]', 'Rates with Wilson intervals, per model/intent/query, series breaks']]],
  ['Governance', [['model register --file | model list | model status <id> <status> [--note]', 'Model registry'], ['system register --file | system list', 'AI system register'], ['processing register --file | processing list', 'Records of processing'], ['policy show | policy check --provider --model --classes', 'Inspect and evaluate the active policy'], ['audit verify | audit list [--object-type] [--object-id] [--action] [--limit]', 'Ledger (exit 7 when broken)'], ['cost [--since]', 'Model spend summary'], ['retention apply', 'Purge expired operational data'], ['export --out f', 'Complete tenant export'], ['erase tenant --reason t --confirm', 'Erase all tenant data except the ledger']]],
  ['Quality', [['evals run [--dataset f] [--out f]', 'Deterministic datasets (exit 8 on failure)'], ['demo load', 'Load the fictional Northwind Bank dataset']]],
];
---
<Base title="CLI reference" description="Reference for the evidentia command-line interface: global options, commands for store, readiness, knowledge, content, observatory, governance and quality, and exit codes." path="/docs/cli" pageType="TechArticle" breadcrumbs={[{ name: 'Documentation', path: '/docs' }, { name: 'CLI reference', path: '/docs/cli' }]}>
  <section class="hero wrap"><span class="eyebrow">Docs</span><h1>CLI reference</h1><p class="lede">Global options on every command: <code>--db</code>, <code>--tenant</code>, <code>--actor</code>, <code>--policy</code>, <code>--signing-key</code>, <code>--json</code>, <code>--verbose</code> (or the <code>EVIDENTIA_*</code> environment variables).</p></section>
  <section class="block"><div class="wrap">
    {groups.map(([g, cmds]) => <div style="margin-bottom:28px"><h2>{g}</h2><div class="table-wrap" tabindex="0"><table><thead><tr><th scope="col">Command</th><th scope="col">Purpose</th></tr></thead><tbody>{(cmds as string[][]).map(([c, p]) => <tr><td><code>{c}</code></td><td>{p}</td></tr>)}</tbody></table></div></div>)}
    <h2>Exit codes</h2>
    <div class="table-wrap" tabindex="0"><table><tbody>
      <tr><td>0</td><td>ok</td></tr><tr><td>1</td><td>error</td></tr><tr><td>2</td><td>usage / validation</td></tr><tr><td>3</td><td>policy denied</td></tr><tr><td>4</td><td>approval required</td></tr><tr><td>5</td><td>document quarantined</td></tr><tr><td>6</td><td>blocked or unsupported claims</td></tr><tr><td>7</td><td>audit ledger broken</td></tr><tr><td>8</td><td>evals failed</td></tr>
    </tbody></table></div>
  </div></section>
</Base>
