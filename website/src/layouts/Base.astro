---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** Path without trailing slash, e.g. "/product". */
  path: string;
  /** schema.org type for the page: WebPage, TechArticle, FAQPage, AboutPage, ContactPage */
  pageType?: string;
  datePublished?: string;
  dateModified?: string;
  breadcrumbs?: { name: string; path: string }[];
  extraJsonLd?: Record<string, unknown>[];
}

const SITE = 'https://evidentia.clixite.eu';
const { title, description, path, pageType = 'WebPage', datePublished = '2026-09-18', dateModified = '2026-09-18', breadcrumbs = [], extraJsonLd = [] } = Astro.props;
const canonical = `${SITE}${path === '/' ? '' : path}`;
const fullTitle = path === '/' ? 'Evidentia — Governed generative visibility for European organisations' : `${title} · Evidentia`;

const ORG = {
  '@type': 'Organization',
  '@id': 'https://clixite.eu/#organization',
  name: 'Clixite SRL',
  legalName: 'Clixite SRL',
  url: 'https://clixite.eu',
  address: { '@type': 'PostalAddress', addressCountry: 'BE' },
  sameAs: ['https://github.com/clixite'],
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG,
    { '@type': 'WebSite', '@id': `${SITE}/#website`, url: SITE, name: 'Evidentia', publisher: { '@id': ORG['@id'] }, inLanguage: 'en' },
    {
      '@type': 'SoftwareApplication', '@id': `${SITE}/#product`, name: 'Evidentia', applicationCategory: 'BusinessApplication', operatingSystem: 'Node.js 24+',
      description: 'Governed Generative Engine Optimization platform and Agent Skill for European organisations: trusted knowledge, evidence-grounded content, publication gates, AI visibility measurement and EU governance evidence.',
      publisher: { '@id': ORG['@id'] }, url: SITE, softwareVersion: '1.0.0', offers: { '@type': 'Offer', availability: 'https://schema.org/InStock', description: 'Commercial licence from Clixite SRL; contact for terms.' },
    },
    {
      '@type': pageType, '@id': `${canonical}#page`, url: canonical, name: title, description, isPartOf: { '@id': `${SITE}/#website` }, inLanguage: 'en', datePublished, dateModified,
      author: { '@id': ORG['@id'] }, publisher: { '@id': ORG['@id'] },
    },
    ...(breadcrumbs.length ? [{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE }, ...breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 2, name: b.name, item: `${SITE}${b.path}` }))] }] : []),
    ...extraJsonLd,
  ],
};

const nav = [
  { href: '/product', label: 'Product' },
  { href: '/geo-aeo', label: 'GEO / AEO' },
  { href: '/ai-visibility', label: 'AI visibility' },
  { href: '/trusted-knowledge', label: 'Trusted knowledge' },
  { href: '/governance', label: 'Governance' },
  { href: '/eu-readiness', label: 'EU readiness' },
  { href: '/security', label: 'Security' },
  { href: '/docs', label: 'Docs' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="author" content="Clixite SRL">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Evidentia">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content="en_GB">
  <meta property="og:image" content={`${SITE}/og.svg`}>
  <meta name="twitter:card" content="summary_large_image">
  <meta property="article:published_time" content={datePublished}>
  <meta property="article:modified_time" content={dateModified}>
  <meta name="ai-disclosure" content="ai-assisted; human-reviewed">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt (informational)">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/" aria-label="Evidentia home"><svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="4" fill="#0f6e6a"/><path d="M7 8h10M7 12h7M7 16h10" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>Evidentia</a>
      <nav class="site-nav" aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={path === n.href || path.startsWith(n.href + '/') ? 'page' : undefined}>{n.label}</a></li>)}
          <li><a href="/installation">Install</a></li>
          <li><a class="cta" href="/contact">Contact Clixite</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <div class="cols">
        <div><strong>Product</strong><ul><li><a href="/product">Product</a></li><li><a href="/architecture">Architecture</a></li><li><a href="/use-cases">Use cases</a></li><li><a href="/why">Why Evidentia exists</a></li><li><a href="/changelog">Changelog</a></li></ul></div>
        <div><strong>Method</strong><ul><li><a href="/geo-aeo">GEO / AEO methodology</a></li><li><a href="/ai-visibility">AI visibility</a></li><li><a href="/trusted-knowledge">Trusted knowledge</a></li><li><a href="/faq">FAQ</a></li></ul></div>
        <div><strong>Trust</strong><ul><li><a href="/governance">Governance</a></li><li><a href="/eu-readiness">EU readiness</a></li><li><a href="/security">Security</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/legal">Legal</a></li><li><a href="/licence">Licence &amp; attribution</a></li></ul></div>
        <div><strong>Get started</strong><ul><li><a href="/installation">Installation</a></li><li><a href="/docs">Documentation</a></li><li><a href="/contact">Contact</a></li><li><a href="https://github.com/clixite/GEO-EU" rel="noopener">Source repository</a></li></ul></div>
      </div>
      <div class="legal">
        <p class="mark-line">Built and maintained by Clixite SRL — Belgium</p>
        <p>Evidentia is a product of Clixite SRL. Inspired by the open-source GEOFlow project by Yao Jingang (AGPL-3.0); Evidentia is an independent, clean-room implementation — see <a href="/licence">Licence &amp; attribution</a>. Nothing on this site is legal advice. Site text prepared with AI assistance under editorial review by Clixite SRL; last reviewed {dateModified}.</p>
      </div>
    </div>
  </footer>
</body>
</html>
