# Evidentia — environment variable names (values are never committed).
# Copy to .env for local use and load with your process manager; the CLI and
# console read process.env only.

# Store and identity
EVIDENTIA_DB=.evidentia/evidentia.db
EVIDENTIA_TENANT=default
EVIDENTIA_ACTOR=you@example.org
EVIDENTIA_POLICY=governance/policies/eu-default.yaml
EVIDENTIA_SIGNING_KEY=.evidentia/signing-key.json

# Model providers (only the ones you registered; names follow EVIDENTIA_PROVIDER_<PROVIDER>_API_KEY)
EVIDENTIA_PROVIDER_MISTRAL_API_KEY=
EVIDENTIA_PROVIDER_ANTHROPIC_API_KEY=
EVIDENTIA_PROVIDER_OPENAI_API_KEY=
EVIDENTIA_PROVIDER_GOOGLE_API_KEY=
EVIDENTIA_PROVIDER_AZURE_OPENAI_API_KEY=

# Publishing targets
EVIDENTIA_PUBLISH_WORDPRESS=user:application-password
EVIDENTIA_PUBLISH_HTTP_SECRET=

# Governance console
EVIDENTIA_ADMIN_SECRET=            # >= 32 random characters
EVIDENTIA_ADMIN_USERS=             # JSON array: [{"name":"…","role":"viewer|editor|approver|admin","tokenHash":"<sha256 of token>"}]
EVIDENTIA_PUBLISH_DIR=.evidentia/published
PORT=8787
HOST=127.0.0.1
